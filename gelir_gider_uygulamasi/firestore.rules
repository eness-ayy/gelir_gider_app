rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Yardımcı fonksiyon: Oturum açmış herhangi bir kullanıcı (Anonim veya Email/Google)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Yardımcı fonksiyon: Doküman sahibi kontrolü
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // 1. KULLANICI PROFİLİ VE ALT KOLEKSİYONLARI (transactions, categories, vb.)
    // =========================================================================
    // users/{userId} dokümanı (Profil bilgileri, rumuz, e-posta vb.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Kullanıcının altındaki TÜM alt koleksiyonlar:
      // - users/{userId}/transactions/{transactionId}
      // - users/{userId}/categories/{categoryId}
      // - users/{userId}/accounts/{accountId}
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // =========================================================================
    // 2. ORTAK BÜTÇE / HARCAMA GRUPLARI (groups) VE ALT KOLEKSİYONLARI
    // =========================================================================
    match /groups/{groupId} {
      // Bir kullanıcının gruba üye olup olmadığını kontrol eden yardımcı fonksiyon
      function isGroupMember() {
        return isAuthenticated() && (
          (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
          (resource.data.createdById != null && request.auth.uid == resource.data.createdById) ||
          (resource.data.memberUids == null && resource.data.createdById == null)
        );
      }

      // Sadece grubu oluşturan kişinin silebilmesi için kontrol
      function isGroupCreator() {
        return isAuthenticated() && (
          (resource.data.createdById != null && request.auth.uid == resource.data.createdById) ||
          (resource.data.createdById == null)
        );
      }

      // Okuma (get & list):
      // - Üyeler grubu okuyabilir
      // - Davet koduyla arama yapan oturum açmış kullanıcılar (koda göre arama) okuyabilir
      allow read: if isAuthenticated() && (
        isGroupMember() ||
        (resource.data.inviteCode != null)
      );

      // Yeni grup oluşturma: Oturum açmış kullanıcılar oluşturabilir
      allow create: if isAuthenticated();

      // Güncelleme:
      // - Mevcut üyeler grubu güncelleyebilir
      // - Veya davet koduyla yeni katılan kişi kendisini 'members' / 'memberUids' listesine ekleyebilir
      allow update: if isAuthenticated() && (
        isGroupMember() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids'])
      );

      // Grubu silme: SADECE grubu kuran kişi silebilir!
      allow delete: if isAuthenticated() && isGroupCreator();

      // Grupların altındaki harcamalar (expenses) ve ihtiyaç listesi (needs)
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids == null ||
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids ||
          request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdById
        );
      }
    }

    // =========================================================================
    // 3. GENEL KOLEKSİYONLAR (Genel kategoriler)
    // =========================================================================
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      // İstemcilerin genel kategorileri silmesini veya üzerine yazmasını engelle
      allow write: if false;
    }

    // =========================================================================
    // 4. GERİ BİLDİRİM VE İLETİŞİM (feedbacks)
    // =========================================================================
    match /feedbacks/{feedbackId} {
      // Yalnızca oturum açmış kullanıcıların yeni belge eklemesine izin ver
      allow create: if isAuthenticated();
      // Başkalarının geri bildirimlerini okuma, güncelleme veya silmeyi engelle
      allow read, update, delete: if false;
    }
  }
}
